# File này quyết định thứ KHÔNG được copy vào image (build context).
# Bỏ sót .env = leak secret vào image. Bỏ sót .git = image phình to.

# Secret — tuyệt đối không vào image
.env
.env.*
!.env.example

# Git
.git
.gitignore
.github

# Python cache & môi trường ảo
__pycache__
*.pyc
*.pyo
.venv
venv
.pytest_cache

# Không cần lúc chạy
tests
screenshots
*.md
Dockerfile*
docker-compose.yml
nginx
.vscode
.idea
